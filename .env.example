# Default: real processed corpus; online only when GEMINI_API_KEY exists.
WHOAMI_DEMO=0
# WHOAMI_OFFLINE=1 forces cached/precalculated answers only.
# For the independent synthetic demo, set WHOAMI_DEMO=1 and WHOAMI_OFFLINE=1.
WHOAMI_GENERATION_TIMEOUT=20
WHOAMI_GENERATION_ATTEMPTS=3
# Optional: actual provider daily request quota from AI Studio.
# WHOAMI_GENERATION_DAILY_LIMIT=500
# Shared ledger and persistent editor reservations must be shared by all workers.
# WHOAMI_LEDGER=C:/local-data/whoami/ledger.jsonl
# WHOAMI_GENERATION_QUOTA_DB=C:/local-data/whoami/ledger.quota.sqlite3
# WHOAMI_EMBEDDING_THREADS=2
# SQLite defaults to %LOCALAPPDATA%/whoami/editorial.sqlite3 on Windows.
# WHOAMI_DATABASE=C:/local-data/whoami/editorial.sqlite3
# WHOAMI_DATA_DIRECTORY=data/processed
# WHOAMI_OUTPUT_DIRECTORY=outputs
# G4 calls the shared backend Gemini client after constructing its evidence prompt.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=
