# Start offline with synthetic news and precalculated answers.
WHOAMI_DEMO=1
WHOAMI_OFFLINE=1
# SQLite defaults to %LOCALAPPDATA%/whoami/editorial.sqlite3 on Windows.
# WHOAMI_DATABASE=C:/local-data/whoami/editorial.sqlite3
# WHOAMI_DATA_DIRECTORY=data/processed
# WHOAMI_OUTPUT_DIRECTORY=outputs
# G4 calls the shared backend Gemini client after constructing its evidence prompt.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=
